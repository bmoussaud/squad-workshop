using './main.bicep'

param location = 'swedencentral'
param applicationLocation = 'francecentral'
param environmentName = readEnvironmentVariable('AZURE_ENV_NAME')
param containerAppName = readEnvironmentVariable('CONTAINER_APP_NAME', '')
param containerAppsEnvironmentName = readEnvironmentVariable('CONTAINER_APPS_ENVIRONMENT_NAME', '')
param storageAccountName = readEnvironmentVariable('STORAGE_ACCOUNT_NAME', '')
param virtualNetworkName = readEnvironmentVariable('VIRTUAL_NETWORK_NAME', '')
param ephemeralTag = readEnvironmentVariable('EPHEMERAL_CHILD_TAG', '')
param prNumberTag = readEnvironmentVariable('PR_NUMBER_TAG', '')
param authorTag = readEnvironmentVariable('AUTHOR_TAG', '')
param createdAtTag = readEnvironmentVariable('CREATED_AT_TAG', '')
param deployFoundry = bool(readEnvironmentVariable('DEPLOY_FOUNDRY', 'false'))
param foundryAccountName = readEnvironmentVariable('FOUNDRY_ACCOUNT_NAME', 'fnd-fantasy-cards-dev-8f327f8c')
param foundryProjectName = readEnvironmentVariable('FOUNDRY_PROJECT_NAME', 'prj-fantasy-cards-dev-8f327f8c')
param sharedFoundryAccountName = readEnvironmentVariable('SHARED_FOUNDRY_ACCOUNT_NAME', '')
param sharedFoundryProjectName = readEnvironmentVariable('SHARED_FOUNDRY_PROJECT_NAME', '')
param sharedFoundryResourceGroupName = readEnvironmentVariable('SHARED_FOUNDRY_RESOURCE_GROUP_NAME', '')
param deployAcr = bool(readEnvironmentVariable('DEPLOY_ACR', 'true'))
param sharedContainerRegistryName = readEnvironmentVariable('SHARED_CONTAINER_REGISTRY_NAME', '')
param sharedContainerRegistryResourceGroupName = readEnvironmentVariable('SHARED_CONTAINER_REGISTRY_RESOURCE_GROUP_NAME', '')
param platformIdentityName = readEnvironmentVariable('PLATFORM_IDENTITY_NAME', 'id-fantasy-cards-platform-dev-8f327f8c')
param applicationIdentityName = readEnvironmentVariable('APPLICATION_IDENTITY_NAME', 'id-fantasy-cards-app-dev-8f327f8c')
param logAnalyticsWorkspaceName = readEnvironmentVariable('LOG_ANALYTICS_WORKSPACE_NAME', 'log-fantasy-cards-dev-8f327f8c')
param applicationInsightsName = readEnvironmentVariable('APPLICATION_INSIGHTS_NAME', 'appi-fantasy-cards-dev-8f327f8c')
param modelDeploymentName = readEnvironmentVariable('MODEL_DEPLOYMENT_NAME', 'gpt-image-2-dev')
param modelName = 'gpt-image-2'
param modelVersion = '2026-04-21'
param modelSkuName = 'GlobalStandard'
param modelCapacity = 1
param workloadProfileType = readEnvironmentVariable('AZURE_CONTAINER_APPS_WORKLOAD_PROFILE_TYPE')
param workloadProfileMinimumCount = int(readEnvironmentVariable('AZURE_CONTAINER_APPS_WORKLOAD_PROFILE_MIN_COUNT'))
param workloadProfileMaximumCount = int(readEnvironmentVariable('AZURE_CONTAINER_APPS_WORKLOAD_PROFILE_MAX_COUNT'))
param containerCpu = readEnvironmentVariable('AZURE_CONTAINER_APP_CPU')
param containerMemory = readEnvironmentVariable('AZURE_CONTAINER_APP_MEMORY')
param monthlyBudgetAmount = int(readEnvironmentVariable('AZURE_MONTHLY_BUDGET_AMOUNT'))
param budgetStartDate = readEnvironmentVariable('AZURE_BUDGET_START_DATE')
param alertContactEmails = split(readEnvironmentVariable('AZURE_ALERT_CONTACT_EMAILS'), ';')
param enableApplicationSignalAlerts = bool(readEnvironmentVariable('AZURE_ENABLE_APPLICATION_SIGNAL_ALERTS'))
param oidcTenantId = readEnvironmentVariable('AZURE_TENANT_ID')
param oidcClientId = readEnvironmentVariable('FANTASY_CARD_OIDC_CLIENT_ID')
param oidcClientSecret = readEnvironmentVariable('FANTASY_CARD_OIDC_CLIENT_SECRET')
param sessionSecretCurrent = readEnvironmentVariable('FANTASY_CARD_SESSION_SECRET_CURRENT')
param sessionSecretPrevious = readEnvironmentVariable('FANTASY_CARD_SESSION_SECRET_PREVIOUS')
param applicationExternalIngress = bool(readEnvironmentVariable('FANTASY_CARD_EXTERNAL_INGRESS', 'true'))